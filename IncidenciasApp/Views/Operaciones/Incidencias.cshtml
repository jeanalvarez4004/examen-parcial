@model IEnumerable<IncidenciasApp.Models.Incidencia>
@{
    ViewData["Title"] = "Incidencias";
}

<div class="hero-bici">
    <h1>Incidencias abiertas en tiempo real</h1>
    <p>🚲 Red de bicicletas compartidas · Panel de operaciones · <span id="ws-estado" class="badge bg-light text-dark">● conectando…</span></p>
</div>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success">@exito</div>
}
<div id="ws-aviso" class="alert alert-info mt-2 d-none"></div>

<div class="card card-bici mb-3">
<div class="card-body">
<form method="get" class="row g-3">
    <div class="col-md-6">
        <input name="q" class="form-control form-control-lg" placeholder="🔍 Buscar por estación o descripción…" value="@ViewBag.Q" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button class="btn btn-bici" type="submit">Buscar</button>
        <a class="btn btn-secondary" href="/Operaciones/Incidencias">Limpiar</a>
    </div>
    @if (ViewBag.Fuente is string fuente)
    {
        <div class="col-md-2 d-flex align-items-center"><span class="badge bg-info">Fuente: @fuente</span></div>
    }
</form>
</div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay incidencias abiertas.</div>
}
else
{
    <table class="table tabla-bici align-middle">
        <thead>
            <tr><th>#</th><th>Estación</th><th>Descripción</th><th>Prioridad</th><th>Reportada</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr data-incidencia-id="@i.Id">
                    <td><strong>#@i.Id</strong></td>
                    <td>📍 @i.Estacion</td>
                    <td>@i.Descripcion</td>
                    <td>
                        @if (i.Prioridad >= 3)
                        {
                            <span class="badge bg-danger">🔴 Alta (@i.Prioridad)</span>
                        }
                        else if (i.Prioridad == 2)
                        {
                            <span class="badge bg-warning text-dark">🟡 Media (@i.Prioridad)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">🟢 Baja (@i.Prioridad)</span>
                        }
                    </td>
                    <td>@i.FechaReporte.ToLocalTime().ToString("g")</td>
                    <td>
                        <form asp-action="Cerrar" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@i.Id" />
                            <button class="btn btn-sm btn-acento" type="submit">✔ Cerrar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
<script src="https://cdn.piesocket.com/piesocket.js"></script>
<script>
(function () {
  var badge = document.getElementById('ws-estado');
  var aviso = document.getElementById('ws-aviso');
  function setEstado(t, cls) { badge.textContent = '● ' + t; badge.className = 'badge ' + cls; }
  function resync() {
    fetch('/Operaciones/AbiertasJson').then(function (r) { return r.json(); }).then(function (ids) {
      document.querySelectorAll('tr[data-incidencia-id]').forEach(function (tr) {
        if (!ids.includes(parseInt(tr.getAttribute('data-incidencia-id')))) tr.remove();
      });
    }).catch(function () {});
  }
  fetch('/Operaciones/RealtimeConfig').then(function (r) { return r.json(); }).then(function (cfg) {
    if (!cfg.configurado) { setEstado('tiempo real no configurado', 'bg-warning'); return; }
    var ps = new PieSocket({ clusterId: cfg.clusterId, apiKey: cfg.apiKey });
    var canal = ps.subscribe(cfg.room);
    canal.listen('system:connected', function () { setEstado('en línea', 'bg-success'); resync(); });
    canal.listen('IncidenciaActualizada', function (d) {
      var tr = document.querySelector('tr[data-incidencia-id="' + d.Id + '"]');
      if (tr && d.Estado === 'Cerrada') tr.remove();
      aviso.textContent = 'Incidencia #' + d.Id + ' ahora está ' + d.Estado + '.';
      aviso.classList.remove('d-none');
    });
    setEstado('en línea', 'bg-success');
  }).catch(function () { setEstado('sin conexión', 'bg-danger'); });
})();
</script>
}
